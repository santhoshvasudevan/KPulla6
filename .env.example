POSTGRES_DB=portfolio_insight_kpulla6
POSTGRES_USER=santhosh_admin
POSTGRES_PASSWORD=kpulla6
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://santhosh_admin:kpulla6@localhost:5432/portfolio_insight_kpulla6

DJANGO_SECRET_KEY=fantastic-to-be-changed-in-local-env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Auth / Google OAuth (backend only — never commit real secrets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI in Google Cloud (localhost vs 127.0.0.1 must be exact).
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8000/accounts/google/login/callback/
DJANGO_SITE_DOMAIN=localhost:8000
# Quote values with spaces when using `make` targets that source .env in the shell.
DJANGO_SITE_NAME="Portfolio Insight Local"
FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set locally to bootstrap the initial owner password (not stored in migrations)
# INITIAL_USER_PASSWORD=

# Frontend (Vite). Leave empty to use dev-server proxy to Django (/api -> :8000).
# Required for iPad/home-LAN access: open http://<mac-lan-ip>:5173 only.
# Do NOT set to http://<mac-ip>:8000 — that bypasses the proxy and breaks LAN use.
VITE_API_BASE_URL=
